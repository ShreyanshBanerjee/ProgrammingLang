pub const TokenKind = core.TokenKind;
pub const Token = core.Token;

pub const Lexer = struct {
    data: []const u8,
    index: i32,

    pub fn build(text: []const u8) Lexer {
        return Lexer{
            .data = text,
            .index = 0
        };
    }

    pub fn peek(self: *Lexer) ?u8 {
        if (self.index < self.data.len) {
            return self.data[self.index];
        }
        return null;
    }

    pub fn expect(self: *Lexer, char: u8) !void {
        if self.data[self.index] == char {
            self.index+=1;
        }
        std.io.debug("Expected {c}, recieved {c} at index {i}", .{char, self.data[self.index], self.index});
        return core.CompilerError.SyntaxError;
    }

    pub fn take_while(self: *Lexer, f: *const fn (u8) bool) []u8 {
        const start = self.index;
        
        while self.index<self.data.len && f(self.data[self.index]) {
            self.index += 1;
        }
        
        return self.data[start..self.index];
    }

